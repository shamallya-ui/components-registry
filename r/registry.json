    {
      "name": "shamallya-cn",
      "type": "registry:lib",
      "title": "cn helper",
      "description": "clsx wrapper. Deliberately not tailwind-merge: it does not know the token utilities.",
      "dependencies": [
        "clsx"
      ],
      "files": [
        {
          "path": "src/lib/cn.ts",
          "type": "registry:lib",
          "target": "src/lib/cn.ts"
        }
      ],
      "registryDependencies": []
    },
    {
      "name": "shamallya-theme",
      "type": "registry:file",
      "title": "Token mapping and Tailwind additions",
      "description": "shadcn variable mapping and the Tailwind extension for ShaMallya tokens.",
      "docs": "Installs @shamallya-ui/tokens 0.5.0. Import its CSS before Tailwind (tokens.css, then themes/slate-teal), and tailwind.config presets: [tokensPreset, shamallya] from ./tailwind.shamallya. Import src/styles/shamallya-mapping.css once. Tailwind 3.4.",
      "dependencies": [
        "@shamallya-ui/tokens@0.5.0",
        "tailwindcss@3.4.19"
      ],
      "files": [
        {
          "path": "src/styles/mapping.css",
          "type": "registry:file",
          "target": "src/styles/shamallya-mapping.css"
        },
        {
          "path": "tailwind.shamallya.ts",
          "type": "registry:file",
          "target": "~/tailwind.shamallya.ts"
        }
      ],
      "registryDependencies": []
    },
